{
  "$schema": "godnaterra/design-tokens@v1",
  "note": "Valores padrão, vendor-neutral. Perfis podem sobrescrever os valores, nunca os nomes semânticos.",
  "color": {
    "bg": "#ffffff",
    "surface": "#f5f5f4",
    "text": "#1c1917",
    "muted": "#57534e",
    "border": "#d6d3d1",
    "accent": "#1d4ed8",
    "danger": "#b91c1c",
    "success": "#15803d"
  },
  "typography": {
    "family": "system-ui, sans-serif",
    "body": "1rem",
    "small": "0.875rem",
    "line-height": 1.5,
    "scale": [1.25, 1.563, 1.953]
  },
  "spacing": [0.25, 0.5, 0.75, 1, 1.5, 2, 3, 4],
  "radius": {
    "sm": "0.25rem",
    "md": "0.5rem"
  },
  "focus": {
    "outline-width": "2px",
    "outline-offset": "2px"
  },
  "motion": {
    "duration": "150ms",
    "reduced": "0ms"
  }
}
